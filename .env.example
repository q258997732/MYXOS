# MYXOS 部署环境变量示例
# 复制本文件为 .env 后填入真实值，.env 已被 .gitignore 排除，请勿提交到版本库

# MySQL 数据库配置
# 注意：MYSQL_USER 默认会获得 myxos 库的全部权限，生产环境建议拆分迁移账号与应用账号
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_USER=myxos
MYSQL_PASSWORD=CHANGE_ME_app_password

# JWT 签名密钥，生产环境必须设置为高强度随机字符串（建议 >= 32 字节）
# 生成示例：openssl rand -base64 32
MYXOS_JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_32

# 主服务与采集服务内部通信共享令牌，生产环境必须设置为高强度随机字符串
# 生成示例：openssl rand -base64 32
MYXOS_INTERNAL_TOKEN=CHANGE_ME_use_openssl_rand_base64_32
