# 多阶段构建：先使用 Maven 构建采集服务，再复制 jar 到 JRE 镜像
FROM maven:3.8-eclipse-temurin-8-alpine AS builder
WORKDIR /app
COPY . .
# 构建采集服务及其依赖模块，跳过测试
RUN mvn -pl myxos-common,myxos-domain,myxos-collector-service -am clean package -DskipTests

FROM eclipse-temurin:8-jre-alpine
WORKDIR /app
COPY --from=builder /app/myxos-collector-service/target/*.jar app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "app.jar"]
